{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Pipeline de Fotos & Métricas de Negócio",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(photo_processing_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Duração",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(photo_processing_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 (Mediana)",
          "refId": "B"
        }
      ],
      "title": "Tempo de Processamento por Foto (p50 / p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(photo_processing_success_total[1m]))",
          "legendFormat": "Fotos Processadas com Sucesso (ops/s)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(photo_processing_failure_total[1m]))",
          "legendFormat": "Fotos com Falha (ops/s)",
          "refId": "B"
        }
      ],
      "title": "Taxa de Sucesso vs Falha no Processamento",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_ready{queue=~\"photos.*\"}) or vector(0)",
          "legendFormat": "Mensagens na Fila RabbitMQ",
          "refId": "A"
        }
      ],
      "title": "Fila RabbitMQ (Backlog de Fotos Pendentes)",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Infraestrutura & Requisições HTTP",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application, uri, status)",
          "legendFormat": "{{application}} {{status}} {{uri}}",
          "refId": "A"
        }
      ],
      "title": "Throughput HTTP por Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "system_cpu_usage",
          "legendFormat": "CPU Usage ({{application}})",
          "refId": "A"
        },
        {
          "expr": "process_cpu_usage",
          "legendFormat": "Process CPU ({{application}})",
          "refId": "B"
        }
      ],
      "title": "Uso de CPU dos Serviços",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 8,
      "title": "Logs Estruturados (Loki)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{app=~\"photo-api|image-worker|vision-service\"} | json",
          "refId": "A"
        }
      ],
      "title": "Logs de Aplicação em Tempo Real",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["agnitio", "production", "observability"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Agnitio - Visão Geral do Sistema",
  "uid": "agnitio-overview",
  "version": 1
}
