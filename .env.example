# ==========================================
# Agnitio - Variáveis de Ambiente Locais
# ==========================================

# PostgreSQL - photo-api
POSTGRES_PHOTO_DB=agnitio_photo
POSTGRES_PHOTO_USER=agnitio_user
POSTGRES_PHOTO_PASSWORD=agnitio_secret
POSTGRES_PHOTO_PORT=5432

# PostgreSQL + pgvector - vision-service
POSTGRES_VISION_DB=agnitio_vision
POSTGRES_VISION_USER=vision_user
POSTGRES_VISION_PASSWORD=vision_secret
POSTGRES_VISION_PORT=5433
VISION_SERVICE_PORT=8001
VISION_SERVICE_URL=http://localhost:8001

# RabbitMQ
RABBITMQ_DEFAULT_USER=agnitio_rabbit
RABBITMQ_DEFAULT_PASS=rabbit_secret
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (S3 Local Storage)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_key
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=agnitio-photos

# S3 Client Configuration (Local / R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret_key
S3_BUCKET=agnitio-photos

# Segurança e JWT
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
INTERNAL_API_KEY=local-dev-internal-api-key-32chars-min

# Observabilidade (Prometheus, Tempo, Loki, Grafana)
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
LOKI_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
